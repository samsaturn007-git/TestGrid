# TestGrid local environment. Copy to .env (`make up` does this if .env is missing).
# Every value here is a FAKE placeholder for local development only. Never put a real
# credential in this file or in .env; .env is git-ignored.

# Host ports (all published on 127.0.0.1 only)
API_PORT=8080
WEB_PORT=3000
DEMO_SHOP_PORT=4173

# PostgreSQL (internal network only, not published to the host)
POSTGRES_DB=testgrid
POSTGRES_USER=testgrid
POSTGRES_PASSWORD=local-dev-only-not-a-secret

# Demo-shop fixture routes (/__fixture/*). Exactly "enabled" or "disabled".
# The local profile enables them; anything else must keep them disabled.
DEMO_SHOP_FIXTURES=enabled

# API profile. Exactly "local" lets runs use demo-shop fixture modes (PRD-02 FR-4).
# Leave it unset anywhere that isn't a developer machine.
TESTGRID_PROFILE=local

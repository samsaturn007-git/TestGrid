# TestGrid local environment. Copy to .env (`make up` does this if .env is missing).
# Every value here is a FAKE placeholder for local development only. Never put a real
# credential in this file or in .env; .env is git-ignored.

# Host ports (all published on 127.0.0.1 only)
API_PORT=8080
WEB_PORT=3000
DEMO_SHOP_PORT=4173

# PostgreSQL (internal network only, not published to the host)
POSTGRES_DB=testgrid
POSTGRES_USER=testgrid
POSTGRES_PASSWORD=local-dev-only-not-a-secret

# RabbitMQ (PRD-04; internal network only, not published to the host). FAKE local values.
RABBITMQ_USER=testgrid
RABBITMQ_PASSWORD=local-dev-only-rabbitmq-not-a-secret

# Demo-shop fixture routes (/__fixture/*). Exactly "enabled" or "disabled".
# The local profile enables them; anything else must keep them disabled.
DEMO_SHOP_FIXTURES=enabled

# API profile. Exactly "local" lets runs use demo-shop fixture modes (PRD-02 FR-4).
# Leave it unset anywhere that isn't a developer machine.
TESTGRID_PROFILE=local

# Worker API service token (PRD-03 FR-2). FAKE local value: the API opens its internal
# port only when this is set, and the worker sends it on every /internal/v1 call.
# Use a fresh random value anywhere that isn't a developer machine.
TESTGRID_WORKER_TOKEN=local-dev-only-worker-token-not-a-secret

# Engines the Compose worker claims (comma-separated). CI and the default use chromium only;
# `make e2e ENGINES="chromium firefox webkit"` needs all three here.
TESTGRID_WORKER_ENGINES=chromium
# Attempts one worker runs at once; also its AMQP prefetch (contracts §9). docs/VERSIONS.md §3:
# 1 by default, 2 only when global_max_sessions allows it.
TESTGRID_WORKER_SLOTS=1

    "dash": "M8 2.5a5.5 5.5 0 1 1 0 11a5.5 5.5 0 1 1 0-11zM5.5 8h5",
    "zig": "M1.8 9.5l2.4-3 2.6 4 2.5-5 2.5 4 2.4-2.5",

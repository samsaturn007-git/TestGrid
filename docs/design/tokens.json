  "space": {
    "0.5": 2,
    "1": 4,
    "1.5": 6,
    "2": 8,
    "3": 12,
    "4": 16,
    "5": 20,
    "6": 24,
    "8": 32,
    "10": 40,
    "12": 48,
    "16": 64
  },
  "radius": { "tag": 4, "chip": 6, "card": 8, "panel": 10, "dialog": 12, "full": 999 },
  "type": {
    "fontSans": "Inter",
    "fontMono": "JetBrains Mono",
    "numerals": "tabular-nums everywhere numbers line up",
    "display": { "font": "sans", "weight": 700, "size": 32, "line": 40, "tracking": "-0.025em" },
    "title": { "font": "sans", "weight": 600, "size": 22, "line": 28, "tracking": "-0.01em" },
    "heading": { "font": "sans", "weight": 600, "size": 16, "line": 24 },
    "body": { "font": "sans", "weight": 400, "size": 14, "line": 20 },
    "bodySm": { "font": "sans", "weight": 400, "size": 13, "line": 18 },
    "label": {
      "font": "mono",
      "weight": 500,
      "size": 11,
      "line": 16,
      "tracking": "0.08em",
      "case": "upper"
    },
    "mono": { "font": "mono", "weight": 400, "size": 13, "line": 20 },
    "monoSm": { "font": "mono", "weight": 500, "size": 12, "line": 16 },
    "numeral": { "font": "mono", "weight": 600, "size": 28, "line": 32 }
  },
  "elevation": {
    "e0": "surface + 1px hairline (cards, tables)",
    "e1": "raised + 1px hairlineStrong (hover rows, inputs)",
    "e2": "overlay + hairlineStrong + shadowPopover (menus, command palette, tooltips, toasts)",
    "e3": "overlay + hairlineStrong + shadowDialog (dialogs, drawers)"
  },
  "focus": { "width": 2, "offset": 2, "style": "solid", "trigger": ":focus-visible" },
  "motion": {
    "statusChange": { "ms": 160, "what": "chip colour and icon cross-fade" },
    "arrival": {
      "ms": 1200,
      "what": "new row slides 4px and its info tint fades out; 2px info edge"
    },
    "runningPulse": {
      "ms": 1600,
      "what": "opacity 1 to 0.35 on the RUNNING icon only; stops while live updates are paused"
    },
    "reducedMotion": "all of the above become instant; the pulse is static"
  },
  "badge": {
    "chip": {
      "height": 24,
      "paddingX": [7, 9],
      "gap": 6,
      "icon": 14,
      "radius": "chip",
      "font": "monoSm",
      "anatomy": "tint background, 1px rim, fg icon + fg label"
    },
    "dense": {
      "height": 20,
      "gap": 6,
      "icon": 12,
      "font": "monoSm",
      "anatomy": "fg icon + label in text colour, no background"
    },
    "rule": "The label is always the exact enum value. Every badge also has an aria-label."
  },
  "icons": {

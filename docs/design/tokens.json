    "minus": "M3 3h10v10H3zM5.5 8h5",
    "neq": "M4.5 6.5h7M4.5 9.5h7M10 3.8l-4 8.4",
    "active": "M8 2.5a5.5 5.5 0 1 1 0 11a5.5 5.5 0 1 1 0-11zM8 6.3a1.7 1.7 0 1 1 0 3.4a1.7 1.7 0 1 1 0-3.4z",
    "drain": "M8 2.5a5.5 5.5 0 1 1 0 11a5.5 5.5 0 1 1 0-11zM8 5v5M6 8l2 2 2-2",
    "file": "M4 2h5l3 3v9H4zM9 2v3h3"
  },
  "dashedIcon": "stroke-dasharray 1.4 2.1, used where statusMap says dashed",
  "statusMap": {
    "run_target_attempt": {
      "QUEUED": { "role": "neutral", "icon": "ring" },
      "CLAIMED": { "role": "info", "icon": "ring", "dashed": true },
      "RUNNING": { "role": "info", "icon": "run", "pulse": true },
      "PASSED": { "role": "success", "icon": "check" },
      "FAILED": { "role": "danger", "icon": "cross" },
      "TIMED_OUT": { "role": "warning", "icon": "clock" },
      "INFRA_ERROR": { "role": "infra", "icon": "plug" },
      "CANCELLED": { "role": "neutral", "icon": "slash" },
      "ABANDONED": { "role": "abandoned", "icon": "broken" }
    },
    "case": {
      "PASSED": { "role": "success", "icon": "check" },
      "FAILED": { "role": "danger", "icon": "cross" },
      "TIMED_OUT": { "role": "warning", "icon": "clock" },
      "SKIPPED": { "role": "neutral", "icon": "dash" },
      "FLAKY": { "role": "flaky", "icon": "zig" }
    },
    "qualityOutcome": {
      "PASS": { "role": "success", "icon": "check" },
      "FAIL": { "role": "danger", "icon": "cross" },
      "INDETERMINATE": { "role": "infra", "icon": "quest" },
      "QUARANTINED_FAIL": {
        "role": "neutral",
        "icon": "shield",
        "note": "rule-report row label, not a QualityOutcome value"
      }
    },
    "failureCategory": {
      "PRODUCT_SUSPECTED": { "role": "danger", "icon": "box" },
      "TEST_BROKEN": { "role": "danger", "icon": "code" },
      "AUTOMATION_FLAKE": { "role": "flaky", "icon": "zig" },
      "TIMEOUT": { "role": "warning", "icon": "clock" },
      "ENVIRONMENT": { "role": "infra", "icon": "plug" },
      "UNKNOWN": { "role": "neutral", "icon": "quest" }
    },
    "comparison": {
      "NEW_FAILURE": { "role": "danger", "icon": "cross" },
      "FIXED": { "role": "success", "icon": "check" },
      "STILL_FAILING": { "role": "danger", "icon": "cross", "dashed": true },
      "STILL_PASSING": { "role": "neutral", "icon": "check" },
      "FLAKY_IN_HEAD": { "role": "flaky", "icon": "zig" },
      "ADDED": { "role": "info", "icon": "plus" },
      "REMOVED": { "role": "neutral", "icon": "minus" },
      "NOT_COMPARABLE": { "role": "neutral", "icon": "neq" }
    },
    "caseHealth": {
      "STABLE": { "role": "success", "icon": "check" },
      "FLAKY": { "role": "flaky", "icon": "zig" },
      "FAILING": { "role": "danger", "icon": "cross" },
      "INSUFFICIENT_DATA": { "role": "neutral", "icon": "ring", "dashed": true }
    },
    "workerState": {
      "ACTIVE": { "role": "success", "icon": "active" },
      "DRAINING": { "role": "warning", "icon": "drain" },
      "LOST": { "role": "abandoned", "icon": "broken", "rowOpacity": 0.62 }
    },
    "artifactState": {
      "AVAILABLE": { "role": "info", "icon": "file" },
      "EXPIRED": { "role": "neutral", "icon": "clock" },
      "MISSING": { "role": "warning", "icon": "quest" },
      "PURGED": { "role": "neutral", "icon": "slash" }
    },
    "errorClassTagText": {
      "ASSERTION": "danger",
      "SELECTOR_NOT_FOUND": "danger",
      "TEST_TIMEOUT": "warning",
      "BROWSER_LAUNCH": "infra",
      "WORKER_LOST": "infra",
      "WORKER_SHUTDOWN": "infra",
      "LEASE_EXPIRED": "infra",
      "NETWORK": "infra",
      "ARTIFACT_STORE": "infra",
      "CONFIG": "infra",
      "CANCELLED": "neutral",
      "UNKNOWN": "neutral"
    },
    "neutralTags": {
      "Trigger": ["MANUAL", "CI", "RERUN", "BENCHMARK", "CHAOS"],
      "FixtureMode": ["PASS", "PRODUCT_DEFECT", "AUTOMATION_FLAKE", "SELECTOR_DRIFT", "TIMEOUT"],
      "Engine": { "chromium": "C", "firefox": "F", "webkit": "W" }
    }
  }
}
